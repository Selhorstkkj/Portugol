algoritmo "AprovacaoAluno"

var
  nota: real
  frequencia: inteiro
  notaMinima: real
  frequenciaMinima: inteiro

inicio
  nota <- 7.5
  frequencia <- 70
  notaMinima <- 6
  frequenciaMinima <- 75

  escreval("Aprovado (nota E frequência)? ", nota >= notaMinima E frequencia >= frequenciaMinima)
  escreval("Atingiu algum dos requisitos? ", nota >= notaMinima OU frequencia >= frequenciaMinima)
  escreval("Não atingiu nenhum requisito? ", NAO(nota >= notaMinima OU frequencia >= frequenciaMinima))
fimalgoritmo